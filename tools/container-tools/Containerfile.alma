# AlmaLinux base image for building and running the 10-edit editor.
# Same intent as Containerfile.ubuntu; see that file for the list of
# tools the editor expects.

FROM almalinux:9

RUN dnf install -y epel-release \
    && dnf install -y --setopt=install_weak_deps=False \
        git \
        make \
        gcc gcc-c++ \
        llvm-devel clang-devel \
        lldb python3-lldb \
        python3 python3-pip \
        python3-qt5 python3-qt5-webengine \
        python3-paramiko \
        qt5-qttools-devel \
        xorg-x11-apps \
    && dnf clean all

WORKDIR /work
CMD ["/bin/bash"]
