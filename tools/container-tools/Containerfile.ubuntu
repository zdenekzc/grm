# Ubuntu base image for building and running the 10-edit editor inside
# a container. Matches the minimum toolchain the host expects:
#   - python3 + PyQt5 (editor UI, WebEngine for Help menu)
#   - gcc/g++ + make (Project menu's run/debug C/C++ actions)
#   - llvm + libclang (clang_tree.py AST browser)
#   - lldb + python3-lldb (debugger.py)
#   - paramiko (filemanager.py)
#   - qttools5-dev-tools (Qt Designer, openQtDesigner())
#   - python3-pyqt5.qtdbus (navigateToSlot listener)
#   - git (clone helper, user-facing workflow)

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        make \
        gcc g++ \
        llvm-dev libclang-dev \
        lldb python3-lldb \
        python3 python3-pip \
        python3-pyqt5 python3-pyqt5.qtwebengine python3-pyqt5.qtdbus \
        python3-pyqt5.qtdesigner \
        python3-paramiko \
        qttools5-dev-tools \
        x11-apps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["/bin/bash"]
