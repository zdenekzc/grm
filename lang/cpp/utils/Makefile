# Makefile is generated by boef-makefiles.py

top_srcdir = ..
BUILD = $(top_srcdir)/_build/utils

CXX = g++
CXXFLAGS = \
   -g \
   -w \
   -I .

all: libutils.a

libutils_OBJECTS = \
   $(BUILD)/libutils/conv.o \
   $(BUILD)/libutils/str.o \
   $(BUILD)/libutils/inf.o \
   $(BUILD)/libutils/textio.o \
   $(BUILD)/libutils/envio.o

libutils_FLAGS =

libutils_LDFLAGS =

libutils.a: $(libutils_OBJECTS)
	rm -f $@
	ar rcs $@ $(libutils_OBJECTS)

$(BUILD)/libutils/conv.o: conv.cc
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(libutils_FLAGS) -MMD -MP -c $< -o $@

$(BUILD)/libutils/str.o: str.cc
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(libutils_FLAGS) -MMD -MP -c $< -o $@

$(BUILD)/libutils/inf.o: inf.cc
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(libutils_FLAGS) -MMD -MP -c $< -o $@

$(BUILD)/libutils/textio.o: textio.cc
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(libutils_FLAGS) -MMD -MP -c $< -o $@

$(BUILD)/libutils/envio.o: envio.cc
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(libutils_FLAGS) -MMD -MP -c $< -o $@

-include $(libutils_OBJECTS:.o=.d)

# CLEAN

CLEAN_FILES = \
   libutils.a

clean:
	- rm -rf $(BUILD)
	test -z "$(CLEAN_FILES)" || rm -f $(CLEAN_FILES)

.PHONY: all clean
